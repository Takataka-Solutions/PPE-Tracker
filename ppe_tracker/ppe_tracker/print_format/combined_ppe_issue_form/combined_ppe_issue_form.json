{
  "name": "Combined PPE Issue Form",
  "doctype": "Print Format",
  "doc_type": "PPE Issue Acknowledgement",
  "module": "PPE Tracker",
  "standard": "Yes",
  "print_format_type": "Jinja",
  "raw_printing": 0,
  "html": "<style>\n    .print-format { font-family: Arial, sans-serif; font-size: 12px; }\n    .print-format table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }\n    .print-format th, .print-format td { border: 1px solid #333; padding: 6px 8px; text-align: left; }\n    .print-format th { background-color: #f5f5f5; font-weight: bold; }\n    .header-table td { border: none; padding: 4px 8px; }\n    .signature-table td { border: none; padding: 20px 8px 4px; }\n    .signature-line { border-bottom: 1px solid #333; min-width: 200px; display: inline-block; }\n    h2 { text-align: center; margin-bottom: 20px; }\n</style>\n\n<div class=\"print-format\">\n    <h2>PPE Issue Acknowledgement Form</h2>\n\n    <!-- Header Section -->\n    <table class=\"header-table\">\n        <tr>\n            <td><strong>Employee:</strong></td>\n            <td>{{ doc.employee_name }} ({{ doc.employee }})</td>\n            <td><strong>Department:</strong></td>\n            <td>{{ doc.department }}</td>\n        </tr>\n        <tr>\n            <td><strong>Designation:</strong></td>\n            <td>{{ doc.designation }}</td>\n            <td><strong>Date:</strong></td>\n            <td>{{ doc.acknowledgement_date }}</td>\n        </tr>\n    </table>\n\n    <!-- PPE Items Table -->\n    <table>\n        <thead>\n            <tr>\n                <th>#</th>\n                <th>PPE Item</th>\n                <th>Size</th>\n                <th>Qty</th>\n                <th>Issue Date</th>\n                <th>Expiry Date</th>\n                <th>Condition</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.ppe_issues %}\n            {% set issue = frappe.get_doc(\"PPE Issue\", row.ppe_issue) %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ issue.ppe_item }}</td>\n                <td>{{ issue.size or \"N/A\" }}</td>\n                <td>{{ issue.quantity }}</td>\n                <td>{{ frappe.format_value(issue.issue_date, {\"fieldtype\": \"Date\"}) }}</td>\n                <td>{{ frappe.format_value(issue.expiry_date, {\"fieldtype\": \"Date\"}) if issue.expiry_date else \"N/A\" }}</td>\n                <td>{{ \"Returned\" if issue.get(\"issue_type\") == \"Casual\" else \"New\" }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <p><strong>I acknowledge receipt of the above PPE items and agree to use them in accordance with company safety policies.</strong></p>\n\n    <!-- Signature Block -->\n    <table class=\"signature-table\">\n        <tr>\n            <td>Employee Signature: <span class=\"signature-line\">&nbsp;</span></td>\n            <td>Date: <span class=\"signature-line\">&nbsp;</span></td>\n        </tr>\n        <tr>\n            <td>HR/Witness Signature: <span class=\"signature-line\">&nbsp;</span></td>\n            <td>Date: <span class=\"signature-line\">&nbsp;</span></td>\n        </tr>\n    </table>\n</div>"
}
